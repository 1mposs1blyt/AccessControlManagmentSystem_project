{
  "name": "acms-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@tamagui/babel-plugin": "^2.0.0-rc.41",
    "@tamagui/next-plugin": "^2.0.0-rc.41",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "19.1.10",
    "@types/react-native": "^0.73.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.21.0",
    "prisma": "^7.7.0",
    "turbo": "^2.4.4",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "web": "cd apps/next && yarn next",
    "db-s": "cd packages/db && yarn studio",
    "db-g": "cd packages/db && yarn generate",
    "db-m": "cd packages/db && yarn migrate",
    "db-ldb": "cd packages/db && yarn localdb"
  },
  "eslintConfig": {
    "extends": "next",
    "settings": {
      "next": {
        "rootDir": "apps/next/"
      }
    },
    "root": true
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  },
  "dependencies": {
    "@prisma/client": "^7.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-menu/menu": "^2.0.0",
    "@tamagui/config": "^2.0.0-rc.41",
    "@tamagui/lucide-icons": "2.0.0-rc.26",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-preset-expo": "54.0.10",
    "bcrypt": "^6.0.0",
    "expo-asset": "12.0.13",
    "expo-camera": "17.0.10",
    "expo-linking": "8.0.12",
    "expo-modules-core": "3.0.30",
    "jsonwebtoken": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "^5.2.0",
    "react-native-svg": "15.12.1",
    "react-native-svg-web": "^1.0.9",
    "react-native-worklets-core": "^1.6.3",
    "tamagui": "^2.0.0-rc.41",
    "zustand": "^5.0.12"
  },
  "resolutions": {
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.7",
    "react-native-web": "^0.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}